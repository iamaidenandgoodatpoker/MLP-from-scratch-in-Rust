use byteorder::{BigEndian, ReadBytesExt};
use std::fs::File;
use std::io::{BufReader, Read};
use std::path::Path;
struct Mnist {
    rows: usize,
    cols: usize,
    data: Vec<Vec<u8>>,
}
pub fn read_mnist<P: AsRef<Path>>(path: P) -> std::io::Result<MnistImages> {
        let file = File::open(path)?;
        let mut reader = BufReader::new(file);
        let magic = reader.read_u32::<BigEndian>()?;
        if magic != 2051 {
            return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Invalid magic number"));
        }
        let num_images = reader.read_u32::<BigEndian>()? as usize;
        let rows = reader.read_u32::<BigEndian>()? as usize;
        let cols = reader.read_u32::<BigEndian>()? as usize;
        let mut images = Vec::with_capacity(num_images);
        let image_size = rows * cols;
        for _ in 0..num_images {
            let mut buffer = vec![0u8; image_size];
            reader.read_exact(&mut buffer)?;
            images.push(buffer);
        }
        Ok(MnistImages { rows, cols, data: images })
    }
